<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>C__Editor</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EmbeddedResourceUseDependentUponConvention>false</EmbeddedResourceUseDependentUponConvention>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <NoWarn>$(NoWarn);WFO1000;CS0108;CS8618;CS8603;CS8625;CS0162</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SweetLine" Version="1.1.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude third-party build artifacts from this project's compile items. -->
    <Compile Remove="ThirdParty\**\obj\**\*.cs;ThirdParty\**\bin\**\*.cs" />
    <EmbeddedResource Remove="ThirdParty\**\obj\**\*;ThirdParty\**\bin\**\*" />
    <None Remove="ThirdParty\**\obj\**\*;ThirdParty\**\bin\**\*" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="runtimes\win-x64\native\sweeteditor.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>sweeteditor.dll</TargetPath>
    </Content>

    <Content Include="mingw64\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>mingw64\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </Content>

    <Content Include="editor\syntaxes\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>editor\syntaxes\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </Content>
  </ItemGroup>

</Project>
